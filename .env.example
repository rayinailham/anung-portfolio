# Salin berkas ini jadi `.env.local`, lalu isi nilainya.
# `.gitignore` menutup semua `.env*` kecuali contoh ini — jangan commit kunci.

# Kunci akses Web3Forms untuk form kontak (https://web3forms.com).
# Kosong = tidak ada backend: form jatuh ke draf `mailto:` dan copy-nya bilang begitu.
# Kunci ini memang ikut ke bundel browser; Web3Forms merancangnya sebagai kunci
# pengiriman publik, bukan rahasia. Jangan taruh kredensial lain di sini.
VITE_WEB3FORMS_KEY=

# URL absolut situs setelah domain dipilih, tanpa garis miring di akhir.
# Contoh: https://anung-ramadhan.com
# Dipakai untuk <link rel="canonical">, og:url, og:image, dan twitter:image.
# Kosong = tag sosial memakai host placeholder `https://anung-ramadhan.example`
# dan `npm run build` menulis peringatan.
VITE_SITE_URL=
